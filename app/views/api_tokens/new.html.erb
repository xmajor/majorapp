<div class="page-header">
  <h1>New API Token</h1>
</div>

<%= simple_form_for @api_token do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :name, label: 'Token Name', placeholder: 'e.g. Production Server, CI/CD Pipeline', required: true %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, 'Generate Token', class: 'btn btn-primary' %>
    <%= link_to 'Cancel', api_tokens_path, class: 'btn btn-default' %>
  </div>
<% end %>

# LinkedIn engagement -> outbound credentials & config.
# Copy to .env (which is gitignored) and fill in. NEVER commit real keys.

# --- Secrets ---
APIFY_TOKEN=
HEYREACH_API_KEY=

# --- Run config ---
# Apify actor id in the "user~actor-name" form.
APIFY_ACTOR=apify~linkedin-post-reactions-scraper
# The LinkedIn post whose engagers you want to pull.
POST_URL=
# HeyReach list id to add the leads to (feeds your campaign).
HEYREACH_LIST_ID=

# --- Optional ---
# DRY_RUN=1
# ACTOR_INPUT_JSON={"limit":200}

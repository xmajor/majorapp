# ================================================
# Daily Stats Aggregator - Environment Variables
# ================================================
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file to version control!

# ------------------------------------------------
# Facebook Ads Manager
# ------------------------------------------------
# Get your access token from Facebook Business Manager:
# https://business.facebook.com/settings/system-users
#
# Required permissions: ads_read, ads_management
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
FACEBOOK_AD_ACCOUNT_ID=your_ad_account_id_here

# ------------------------------------------------
# ClickFunnels
# ------------------------------------------------
# Get your API key from ClickFunnels Settings > API
# https://www.clickfunnels.com/api-documentation
CLICKFUNNELS_API_KEY=your_clickfunnels_api_key_here
CLICKFUNNELS_WORKSPACE_ID=your_workspace_id_here

# ------------------------------------------------
# Hyros
# ------------------------------------------------
# Get your API key from Hyros Settings > API
HYROS_API_KEY=your_hyros_api_key_here

# ------------------------------------------------
# Typeform
# ------------------------------------------------
# Get your access token from Typeform Developer Portal:
# https://admin.typeform.com/user/tokens
#
# Form IDs should be comma-separated
TYPEFORM_ACCESS_TOKEN=your_typeform_access_token_here
TYPEFORM_FORM_IDS=form_id_1,form_id_2,form_id_3

# ------------------------------------------------
# Google Sheets Export (Optional)
# ------------------------------------------------
# 1. Create a service account in Google Cloud Console
# 2. Download the JSON credentials file
# 3. Share your spreadsheet with the service account email
#
# Path to your Google service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=config/google_credentials.json

# The ID from your Google Sheets URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# ------------------------------------------------
# Optional: Enable/Disable Specific Sources
# ------------------------------------------------
# Set to 'false' to disable a source (default: enabled)
# STATS_FACEBOOK_ENABLED=true
# STATS_CLICKFUNNELS_ENABLED=true
# STATS_HYROS_ENABLED=true
# STATS_TYPEFORM_ENABLED=true

# ------------------------------------------------
# Rails Configuration
# ------------------------------------------------
SECRET_KEY_BASE=your_secret_key_base_here
RAILS_ENV=development
